PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/smartintern_ai?schema=public"
JWT_SECRET="replace_with_a_long_random_secret"
AI_SERVICE_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"
JSON_BODY_LIMIT="1mb"
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
AUTH_COOKIE_NAME=smartintern_token
AUTH_COOKIE_MAX_AGE_MS=86400000
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="SmartIntern AI <your_email@gmail.com>"
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Without SMTP variables, password reset links are logged and returned only in development.
# Gmail requires an App Password, not the normal account password.
