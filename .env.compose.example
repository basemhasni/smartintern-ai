COMPOSE_PROJECT_NAME=smartintern

POSTGRES_DB=smartintern_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_url_safe_local_password
POSTGRES_HOST_PORT=5433

NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
BACKEND_HOST_PORT=5000
FRONTEND_HOST_PORT=8088
AI_SERVICE_HOST_PORT=8000

VITE_API_TIMEOUT_MS=15000
JSON_BODY_LIMIT=1mb
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
AUTH_COOKIE_NAME=smartintern_token
AUTH_COOKIE_MAX_AGE_MS=86400000
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
CSRF_COOKIE_NAME=smartintern_csrf
CSRF_HEADER_NAME=x-csrf-token
CSRF_COOKIE_MAX_AGE_MS=86400000
CSRF_COOKIE_SAME_SITE=lax
CSRF_COOKIE_SECURE=false

AI_SERVICE_TIMEOUT_MS=15000
AI_SERVICE_HEALTH_TIMEOUT_MS=2500
AI_MATCHING_TIMEOUT_MS=15000
AI_SKILL_GAP_TIMEOUT_MS=20000
AI_GENERATION_TIMEOUT_MS=30000
AI_RAG_TIMEOUT_MS=15000

AI_APP_NAME=SmartIntern AI Service
AI_APP_ENV=production
AI_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5000
SMARTINTERN_SENTENCE_MODEL=all-MiniLM-L6-v2
SMARTINTERN_ALLOW_MODEL_DOWNLOAD=false
RAG_ALLOW_MODEL_DOWNLOAD=false
