{
  "expo": {
    "name": "SmartIntern AI",
    "slug": "smartintern-ai-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartintern.ai"
    },
    "android": {
      "package": "com.smartintern.ai",
      "adaptiveIcon": {
        "backgroundColor": "#050816"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}
