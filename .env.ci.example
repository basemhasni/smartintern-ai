COMPOSE_PROJECT_NAME=smartintern-ci

# Disposable CI-only credentials. Never reuse these values outside CI smoke tests.
POSTGRES_DB=smartintern_ci
POSTGRES_USER=smartintern_ci
POSTGRES_PASSWORD=ci_only_database_password_not_for_production
POSTGRES_HOST_PORT=0
POSTGRES_VOLUME_EXTERNAL=false
POSTGRES_VOLUME_NAME=smartintern-ci-postgres-data
BACKEND_UPLOADS_VOLUME_NAME=smartintern-ci-backend-uploads

NODE_ENV=test
JWT_SECRET=ci_only_jwt_secret_not_for_production_32_chars
BACKEND_HOST_PORT=0
FRONTEND_HOST_PORT=0
AI_SERVICE_HOST_PORT=0

VITE_API_TIMEOUT_MS=15000
JSON_BODY_LIMIT=1mb
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
AUTH_COOKIE_NAME=smartintern_ci_token
AUTH_COOKIE_MAX_AGE_MS=3600000
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
CSRF_COOKIE_NAME=smartintern_ci_csrf
CSRF_HEADER_NAME=x-csrf-token
CSRF_COOKIE_MAX_AGE_MS=3600000
CSRF_COOKIE_SAME_SITE=lax
CSRF_COOKIE_SECURE=false

AI_SERVICE_TIMEOUT_MS=15000
AI_SERVICE_HEALTH_TIMEOUT_MS=2500
AI_MATCHING_TIMEOUT_MS=15000
AI_SKILL_GAP_TIMEOUT_MS=20000
AI_GENERATION_TIMEOUT_MS=30000
AI_RAG_TIMEOUT_MS=15000

AI_APP_NAME=SmartIntern AI CI Service
AI_APP_ENV=test
AI_ALLOWED_ORIGINS=http://frontend:8080,http://backend:5000
SMARTINTERN_SENTENCE_MODEL=all-MiniLM-L6-v2
SMARTINTERN_ALLOW_MODEL_DOWNLOAD=false
RAG_ALLOW_MODEL_DOWNLOAD=false
