# Copy to .env.sonarqube and replace every placeholder locally.
SONAR_HTTP_PORT=9000
SONAR_DB_NAME=sonarqube
SONAR_DB_USER=sonarqube
SONAR_DB_PASSWORD=replace-with-a-long-random-password

# Used only by the local bootstrap procedure, never injected into containers.
SONAR_ADMIN_USER=admin
SONAR_ADMIN_PASSWORD=replace-with-a-different-long-random-password
